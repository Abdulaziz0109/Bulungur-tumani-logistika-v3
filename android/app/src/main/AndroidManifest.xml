<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BulungurMMTB"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Instant native floating search popup directly over home screen (no WebView) -->
        <activity
            android:name=".QuickSearchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.BulungurMMTB.QuickSearch"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <!-- Instant native floating interactive pinch-zoom & finger-pan map overlay -->
        <activity
            android:name=".FloatingMapActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.BulungurMMTB.QuickSearch" />

        <!-- Native Android Home Screen Widget (appears in Samsung One UI Vidjetlar tray) -->
        <receiver
            android:name=".MmtbWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="uz.bulungur.mmtb.ACTION_REFRESH" />
                <action android:name="uz.bulungur.mmtb.ACTION_SET_FILTER" />
                <action android:name="uz.bulungur.mmtb.ACTION_AUTO_TICK" />
                <action android:name="uz.bulungur.mmtb.ACTION_PASSIVE_LOCATION" />
                <action android:name="uz.bulungur.mmtb.ACTION_TOGGLE_LIVE" />
                <action android:name="uz.bulungur.mmtb.ACTION_ZOOM_IN" />
                <action android:name="uz.bulungur.mmtb.ACTION_ZOOM_OUT" />
                <action android:name="uz.bulungur.mmtb.ACTION_ZOOM_AUTO" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mmtb_widget_info" />
        </receiver>

        <!-- Scrollable & vertically expandable widget list service -->
        <service
            android:name=".MmtbWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Continuous live GPS tracking service for real-time auto-zooming widget map -->
        <service
            android:name=".LiveLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
