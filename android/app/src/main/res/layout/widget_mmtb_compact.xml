<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Bar: Xarita / Ro'yxat (Active) Tabs + Live GPS + Refresh + App -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_tab_map"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="🧭 Xarita"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_tab_list"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_pill_active"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="📋 Ro&apos;yxat"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_toggle_live"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:text="○ Jonli"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:text="↻"
            android:textColor="#7DD3FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_open_map"
            android:layout_width="26dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_map_card_bg"
            android:gravity="center"
            android:text="📍"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search & Category Filter Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_quick_search"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1.15"
            android:background="@drawable/widget_pill_bg"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingEnd="5dp"
            android:text="🔍 Qidiruv"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_filter_all"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:layout_weight="0.9"
            android:background="@drawable/widget_pill_active"
            android:gravity="center"
            android:maxLines="1"
            android:text="Barchasi"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_filter_maktab"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:layout_weight="0.85"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="Maktab"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_filter_dmtt"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:layout_weight="0.85"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="Bog&apos;cha"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="#26FFFFFF"
        android:contentDescription="@null" />

    <!-- Full-Height Scrollable Nearby Facilities List -->
    <ListView
        android:id="@+id/lv_widget_locations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:divider="#1AFFFFFF"
        android:dividerHeight="1dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/tv_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Yuklanmoqda..."
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
