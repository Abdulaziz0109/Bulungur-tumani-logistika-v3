<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Compact Top Bar: Title + Live GPS Toggle + Refresh + Full Map -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_toggle_live"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="○ Jonli"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:text="↻"
            android:textColor="#7DD3FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/card_open_map"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_map_card_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="📍 Ilova"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Nearest Hero Info + Direct Yandex / Google Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_hero_dist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.3 km"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_hero_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Yuklanmoqda..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Eng yaqin muassasa"
                android:textColor="#BAE6FD"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_hero_yandex"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/widget_btn_yandex"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Yandex"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_hero_google"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_btn_google"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Google"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search & Category Filter Pills -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_quick_search"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1.25"
            android:background="@drawable/widget_pill_bg"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:text="🔍 Qidiruv"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_filter_all"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:layout_weight="0.88"
            android:background="@drawable/widget_pill_active"
            android:gravity="center"
            android:maxLines="1"
            android:text="Barchasi"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_filter_maktab"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:layout_weight="0.85"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="Maktab"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_filter_dmtt"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:layout_weight="0.85"
            android:background="@drawable/widget_pill_bg"
            android:gravity="center"
            android:maxLines="1"
            android:text="Bog&apos;cha"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full-Bleed Live Auto-Zoom Route Map (Compact Mode) -->
    <RelativeLayout
        android:id="@+id/rl_widget_map_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:background="@drawable/widget_map_card_bg"
        android:padding="1dp">

        <ImageView
            android:id="@+id/iv_widget_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Yaqin muassasaga marshrut xaritasi"
            android:scaleType="centerCrop" />

        <!-- Subtle bottom-left interactive hint badge -->
        <TextView
            android:id="@+id/tv_map_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="6dp"
            android:background="@drawable/widget_map_ctrl_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="Avto masshtab · Surish uchun bosing"
            android:textColor="#E2E8F0"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Right-side Zoom + / - / Auto Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btn_map_zoom_in"
                android:layout_width="28dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_map_ctrl_bg"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_map_zoom_out"
                android:layout_width="28dp"
                android:layout_height="26dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_map_ctrl_bg"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_map_zoom_auto"
                android:layout_width="28dp"
                android:layout_height="26dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/widget_map_ctrl_bg"
                android:gravity="center"
                android:text="◎"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
