<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_map_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/widget_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Target Title + Heading-Up Toggle + Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_fmap_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Jonli marshrut chizmasi"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_fmap_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Yo&apos;nalish bo&apos;yicha avto aylanadi"
                    android:textColor="#93C5FD"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_fmap_rotate"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_pill_active"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🧭 Aylanish"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_fmap_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Category Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fmap_pill_all"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_active"
                android:gravity="center"
                android:text="Barchasi"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fmap_pill_maktab"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:text="Maktab"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fmap_pill_dmtt"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:text="Bog&apos;cha"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Prominent Turn-by-Turn Instruction Banner -->
        <LinearLayout
            android:id="@+id/ll_fmap_turn_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_map_ctrl_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_fmap_turn_arrow"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:text="↱"
                android:textColor="#FBBF24"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_fmap_turn_dist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="240 m"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_fmap_turn_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="O&apos;ngga buriling"
                        android:textColor="#FEF3C7"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_fmap_turn_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Marshrut hisoblanmoqda..."
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 60 FPS Pure Vector Heading-Up Interactive HUD Canvas -->
        <FrameLayout
            android:id="@+id/fmap_canvas_holder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_map_card_bg"
            android:padding="1dp" />

        <!-- Bottom Total Distance Progress Strip (Expanded Widget Only) -->
        <LinearLayout
            android:id="@+id/ll_fmap_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_map_ctrl_bg"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_fmap_total_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Jami masofa: --"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_fmap_total_right"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qoldi: --"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_fmap_route_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="5dp"
                android:max="1000"
                android:progress="0"
                android:progressBackgroundTint="#334155"
                android:progressTint="#38BDF8" />
        </LinearLayout>

        <!-- Bottom Action Bar for Active Target -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_fmap_recenter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="◎ Avto"
                android:textColor="#7DD3FC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_fmap_yandex"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_yandex"
                android:gravity="center"
                android:text="Yandex Navigator"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_fmap_google"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_google"
                android:gravity="center"
                android:text="Google Maps"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
