<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_map_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/widget_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_fmap_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Jonli marshrut xaritasi"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_fmap_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Barmoq bilan suring yoki kattalashtiring"
                    android:textColor="#BAE6FD"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_fmap_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Category Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fmap_pill_all"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_active"
                android:gravity="center"
                android:text="Barchasi"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fmap_pill_maktab"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:text="Maktab"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fmap_pill_dmtt"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:text="Bog&apos;cha"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Interactive Pinch-Zoom & Pan Map Container -->
        <FrameLayout
            android:id="@+id/fmap_canvas_holder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_map_card_bg"
            android:padding="1dp">

            <!-- Floating Google / Yandex Map Style Switcher (syncs with Home Screen Widget too) -->
            <LinearLayout
                android:id="@+id/fmap_provider_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/widget_map_ctrl_bg"
                android:clickable="true"
                android:focusable="true"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/fmap_provider_google"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_btn_google"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Google"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fmap_provider_yandex"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Yandex"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom Action Bar for Active Target -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_fmap_recenter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/widget_pill_bg"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="◎ Avto"
                android:textColor="#7DD3FC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_fmap_yandex"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_yandex"
                android:gravity="center"
                android:text="Yandex Navigator"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_fmap_google"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_google"
                android:gravity="center"
                android:text="Google Maps"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
